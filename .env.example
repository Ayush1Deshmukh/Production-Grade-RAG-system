# ── LLM (generation) ──────────────────────────────────────────────────────────
# Both supported backends speak the OpenAI-compatible protocol, so switching is
# just these three lines. Only the SELECTED provider's key is required — startup
# fails fast with a named error if it is missing.
#
#   groq     -> free tier, get a key at https://console.groq.com/keys
#   cerebras -> requires billing as of Aug 2026; free access was retired
#
# Note the model id differs per provider ("openai/gpt-oss-120b" on Groq,
# "gpt-oss-120b" on Cerebras). Either spelling is accepted and translated.
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=your-groq-key
CEREBRAS_API_KEY=

# ── Unused provider keys (optional — nothing in the code reads them) ─────────
# Embeddings (all-MiniLM-L6-v2) and re-ranking (ms-marco-MiniLM-L-6-v2) run
# locally on HuggingFace models, so no Gemini/Cohere credentials are needed.
GEMINI_API_KEY=
COHERE_API_KEY=

# ── Qdrant ────────────────────────────────────────────────────────────────────
QDRANT_URL=https://your-cluster-id.region.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-key
QDRANT_COLLECTION_NAME=rag_documents

# ── Langfuse (optional — tracing is disabled when these are empty) ────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ── RAG hyperparameters ───────────────────────────────────────────────────────
TOP_K=10
RERANK_TOP_N=5
CHUNK_SIZE=700
CHUNK_OVERLAP=100
PROMPT_VERSION=v1

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
# Comma-separated browser origins allowed to call the API. "*" is refused when
# ENVIRONMENT=production, and disables credentialed CORS everywhere else.
ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# ── Ingest protection ─────────────────────────────────────────────────────────
# /ingest makes the SERVER fetch the URLs you pass it, so it stays disabled
# until you set a secret. Send it as the X-API-Key header.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
INGEST_API_KEY=
# Optional hostname suffix allowlist for /ingest. Empty = any public host.
# Private/loopback/link-local targets are always refused.
INGEST_ALLOWED_DOMAINS=
